# Copy to .env.local and fill in.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable (anon) key — optional, not used by server routes
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret / service_role key — REQUIRED (server-only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx_or_service_role_jwt

# Attendance API base URL
ATTENDANCE_API_BASE_URL=https://api.bharatainternasional.com

# Scheduler
SCHEDULER_ENABLED=true
CRON_TIMEZONE=Asia/Jakarta
CRON_GRACE_MINUTES=5
CRON_SECRET=
